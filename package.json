{
  "name": "eslint-plugin-escompat",
  "version": "3.6.0",
  "type": "module",
  "description": "",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./lib/index.js"
    }
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/keithamus/eslint-plugin-escompat"
  },
  "homepage": "https://github.com/keithamus/eslint-plugin-escompat",
  "license": "MIT",
  "author": "Keith Cirkel (https://keithcirkel.co.uk/)",
  "files": [
    "dist",
    "lib/*"
  ],
  "nyc": {
    "check-coverage": true,
    "lines": 100,
    "functions": 100,
    "statements": 100,
    "branches": 100
  },
  "scripts": {
    "tsc": "tsc",
    "tsc-prod": "tsc -p tsconfig-prod.json",
    "attw": "attw --pack . --profile node16 --profile esm-only",
    "lint": "eslint .",
    "test": "npm run lint && nyc mocha"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/plugin-proposal-do-expressions": "^8.0.1",
    "@babel/plugin-proposal-function-bind": "^8.0.1",
    "@babel/plugin-proposal-pipeline-operator": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.0",
    "nyc": "^18.0.0"
  },
  "peerDependencies": {
    "eslint": ">=9.6.0"
  },
  "dependencies": {
    "browserslist": "^4.28.9"
  }
}
