{
  "compilerOptions": {
    "lib": ["ESNext"],
    "types": ["node", "mocha"],
    "moduleResolution": "nodenext",
    "module": "NodeNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2017"
  },
  "include": ["lib/**/*.js", "lib/**/*.d.ts", "test/**/*.js", "*.js"],
  "exclude": ["node_modules"]
}
